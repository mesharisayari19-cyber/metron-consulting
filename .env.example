# Contact form — SMTP (required for sending messages)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Metron Website <noreply@metron.sa>"

# Recipient inbox for contact form submissions
CONTACT_TO_EMAIL=contact@metron.sa
