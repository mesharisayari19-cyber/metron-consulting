# Contact form — Resend
# Create the real key in Resend, then store it only in Vercel project settings.
RESEND_API_KEY=re_example_replace_in_vercel

# Approved recipient mailbox
CONTACT_TO_EMAIL=contact@metron.sa

# Verified sender on notify.metron.sa
CONTACT_FROM_EMAIL=website@notify.metron.sa

# Shared rate limiting. Required before production submissions are accepted.
# Create an Upstash Redis database and connect it to the Vercel project.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
